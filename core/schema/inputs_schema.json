{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Service Inputs Schema",
  "type": "object",
  "required": ["inputs"],
  "properties": {
    "inputs": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["text", "integer"]
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "default": {},
          "help": {
            "type": "string"
          },
          "constraints": {
            "type": "object",
            "properties": {
              "min": { "type": "integer" },
              "max": { "type": "integer" },
              "minLength": { "type": "integer" },
              "maxLength": { "type": "integer" },
              "pattern": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "type": { "const": "integer" } }
            },
            "then": {
              "properties": {
                "default": { "type": "integer" }
              }
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "text" } }
            },
            "then": {
              "properties": {
                "default": { "type": "string" }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
